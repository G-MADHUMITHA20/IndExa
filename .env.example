# ==============================================
# IndExa Environment Variables Example
# Duplicate this file as .env and update values.
# ==============================================

# Backend Settings
PROJECT_NAME="IndExa Backend"
ENVIRONMENT=development

# MongoDB Connection Configuration
# Format: mongodb://[username:password@]host[:port]/[database][?options]
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=indexa_db

# JWT Authentication Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Controlled Teacher Account Seeding (for development / initial deployment)
# Set ALLOW_SEED_TEACHER=true only when running the explicit seed command.
ALLOW_SEED_TEACHER=false
TEACHER_SEED_NAME="Faculty Administrator"
TEACHER_SEED_EMAIL="teacher@indexa.edu"
TEACHER_SEED_PASSWORD="ChangeMeInProduction123!"

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables (used by Vite)
VITE_API_BASE_URL=http://localhost:8000

